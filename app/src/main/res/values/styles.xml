<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema da entrada do ícone: transparente e sem animação, para não piscar tela. -->
    <style name="Lancador" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="CaixaValor">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/box_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:hint">0</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:digits">0123456789,.</item>
        <item name="android:imeOptions">actionNext|flagNoExtractUi</item>
        <item name="android:maxLines">1</item>
        <item name="android:padding">2dp</item>
        <item name="android:textColor">#FF000000</item>
        <item name="android:textColorHint">#FF9E9E9E</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CaixaResultado">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:text">R$ 0,00</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Legenda">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFBDBDBD</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Seta">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Sinal">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Tela do app (HistoricoActivity) ===== -->

    <style name="TituloSecao">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoAjuda">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Colunas do card de resumo do mês (texto claro sobre fundo verde) -->
    <style name="ColunaResumo">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="RotuloResumo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ValorResumo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Colunas do card de cada dia -->
    <style name="ColunaDia">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="RotuloDia">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ValorDia">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Abas inferiores -->
    <style name="Aba">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="AbaIcone">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">@color/aba_inativa</item>
    </style>

    <style name="AbaTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/aba_inativa</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="BotaoPrimario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/botao_primario_bg</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotaoSecundario" parent="BotaoPrimario">
        <item name="android:background">@drawable/botao_secundario_bg</item>
        <item name="android:textColor">@color/verde</item>
    </style>
</resources>
