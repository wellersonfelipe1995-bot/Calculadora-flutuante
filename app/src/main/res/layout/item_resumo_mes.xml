<?xml version="1.0" encoding="utf-8"?>
<!-- Card de resumo de um mês: líquido em destaque e os demais valores em 2 colunas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_summary_bg"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/mes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D9FFFFFF"
        android:textSize="14sp" />

    <TextView
        style="@style/RotuloResumo"
        android:layout_marginTop="12dp"
        android:text="Líquido do mês" />

    <TextView
        android:id="@+id/liquido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#33FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout style="@style/ColunaResumo">
            <TextView style="@style/RotuloResumo" android:text="Bruto" />
            <TextView android:id="@+id/bruto" style="@style/ValorResumo" />
        </LinearLayout>

        <LinearLayout style="@style/ColunaResumo">
            <TextView android:id="@+id/rotuloCombustivel" style="@style/RotuloResumo" android:text="Combustível" />
            <TextView android:id="@+id/combustivel" style="@style/ValorResumo" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/ColunaResumo">
            <TextView style="@style/RotuloResumo" android:text="Média líquida / dia" />
            <TextView android:id="@+id/media" style="@style/ValorResumo" />
        </LinearLayout>

        <LinearLayout style="@style/ColunaResumo">
            <TextView style="@style/RotuloResumo" android:text="Ganho por km" />
            <TextView android:id="@+id/ganhoPorKm" style="@style/ValorResumo" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/ColunaResumo">
            <TextView style="@style/RotuloResumo" android:text="km rodados" />
            <TextView android:id="@+id/kmMes" style="@style/ValorResumo" />
        </LinearLayout>

        <LinearLayout style="@style/ColunaResumo">
            <TextView style="@style/RotuloResumo" android:text="Média km / dia" />
            <TextView android:id="@+id/kmPorDia" style="@style/ValorResumo" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/dias"
        style="@style/RotuloResumo"
        android:layout_marginTop="16dp" />
</LinearLayout>
