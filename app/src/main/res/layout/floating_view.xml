<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bubble"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bubble_bg"
            android:elevation="6dp"
            android:gravity="center"
            android:text="R$"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLimpar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Limpar"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnFechar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:text="Sair"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Linha 1: ganhos das corridas -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/valor1"
                style="@style/CaixaValor" />

            <TextView style="@style/Sinal" android:text="+" />

            <EditText
                android:id="@+id/valor2"
                style="@style/CaixaValor" />

            <TextView style="@style/Sinal" android:text="+" />

            <EditText
                android:id="@+id/valor3"
                style="@style/CaixaValor" />

            <TextView style="@style/Sinal" android:text="=" />

            <TextView
                android:id="@+id/resultado"
                style="@style/CaixaResultado"
                android:background="@drawable/result_bg" />
        </LinearLayout>

        <!-- Linha 2: gasto com combustível = km ÷ km/l × preço do litro -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/km"
                style="@style/CaixaValor"
                android:hint="km" />

            <TextView style="@style/Sinal" android:text="÷" />

            <EditText
                android:id="@+id/kmPorLitro"
                style="@style/CaixaValor"
                android:hint="km/l" />

            <TextView style="@style/Sinal" android:text="×" />

            <EditText
                android:id="@+id/precoLitro"
                style="@style/CaixaValor"
                android:hint="R$/l" />

            <TextView style="@style/Sinal" android:text="=" />

            <TextView
                android:id="@+id/gasto"
                style="@style/CaixaResultado"
                android:background="@drawable/gasto_bg" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="km rodados ÷ km/l × preço do litro = gasto"
            android:textColor="#FFBDBDBD"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
