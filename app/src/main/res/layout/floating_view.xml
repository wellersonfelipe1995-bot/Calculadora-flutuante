<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bubble"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bubble_bg"
            android:elevation="6dp"
            android:gravity="center"
            android:text="R$"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Dia que está sendo editado (permite lançar dias atrasados) e dia livre -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/diaAnterior"
                style="@style/Seta"
                android:text="◀" />

            <TextView
                android:id="@+id/dataSelecionada"
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/diaSeguinte"
                style="@style/Seta"
                android:text="▶" />

            <!-- Dia livre e compartilhar; na imagem compartilhada dão lugar ao líquido do dia -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:id="@+id/acoesData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/diaLivre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFFFFFFF"
                        android:text="Dia livre"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp" />

                    <!-- Compartilha uma imagem deste card (WhatsApp etc.) -->
                    <ImageView
                        android:id="@+id/compartilhar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Compartilhar"
                        android:padding="6dp"
                        android:src="@drawable/ic_compartilhar" />
                </LinearLayout>

                <!-- Só aparece na imagem compartilhada -->
                <TextView
                    android:id="@+id/liquidoImagem"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FFA5D6A7"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />
            </FrameLayout>
        </LinearLayout>

        <!-- Linha 1: ganhos das corridas -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/valor1"
                style="@style/CaixaValor"
                android:background="@drawable/box_urbano_bg" />

            <TextView style="@style/Sinal" android:text="+" />

            <EditText
                android:id="@+id/valor2"
                style="@style/CaixaValor"
                android:background="@drawable/box_99_bg" />

            <TextView style="@style/Sinal" android:text="+" />

            <EditText
                android:id="@+id/valor3"
                style="@style/CaixaValor"
                android:background="@drawable/box_fora_bg" />

            <TextView style="@style/Sinal" android:text="=" />

            <TextView
                android:id="@+id/resultado"
                style="@style/CaixaResultado"
                android:background="@drawable/result_bg" />
        </LinearLayout>

        <!-- Linha 2: gasto com combustível = km ÷ km/l × preço do litro -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/km"
                style="@style/CaixaValor"
                android:hint="km" />

            <TextView style="@style/Sinal" android:text="÷" />

            <EditText
                android:id="@+id/kmPorLitro"
                style="@style/CaixaValor"
                android:hint="km/l" />

            <TextView style="@style/Sinal" android:text="×" />

            <EditText
                android:id="@+id/precoLitro"
                style="@style/CaixaValor"
                android:hint="R$/l" />

            <TextView style="@style/Sinal" android:text="=" />

            <TextView
                android:id="@+id/gasto"
                style="@style/CaixaResultado"
                android:background="@drawable/gasto_bg" />
        </LinearLayout>

        <!-- Legenda do cálculo + % do combustível sobre o ganho bruto, centralizada sob a caixa do gasto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Legenda"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="km rodados ÷ km/l × R$/litro = gasto" />

            <TextView
                android:id="@+id/percentual"
                style="@style/Legenda"
                android:layout_width="88dp"
                android:gravity="center_horizontal"
                android:text="0%" />
        </LinearLayout>

        <!-- Trechos já guardados com "Abasteci" (só aparece quando há algum) -->
        <LinearLayout
            android:id="@+id/linhaAbastecer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/infoAbastecido"
                style="@style/Legenda"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:maxLines="2" />

            <TextView
                android:id="@+id/btnDesfazer"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="Desfazer"
                android:textColor="#FF90CAF9"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ações do balão: Abasteci à esquerda; Histórico e Sair à direita -->
        <LinearLayout
            android:id="@+id/linhaBotoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAbasteci"
                style="@style/BotaoPainel"
                android:text="⛽ Abasteci" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnHistorico"
                style="@style/BotaoPainel"
                android:text="Histórico" />

            <TextView
                android:id="@+id/btnFechar"
                style="@style/BotaoPainel"
                android:layout_marginStart="6dp"
                android:text="✕ Sair" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
